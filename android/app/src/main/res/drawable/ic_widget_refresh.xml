<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!--
        Keep the exact 200SPX refresh-button style, but reduce only the visible
        button diameter to match the smaller reference screenshot.
        Glance still keeps a large touch target; this drawable only controls
        the visible circle/glyph.
    -->
    <item
        android:width="18dp"
        android:height="18dp"
        android:gravity="end|bottom"
        android:right="4dp"
        android:bottom="4dp"
        android:drawable="@drawable/bg_refresh_circle" />

    <!-- 18dp button with 3dp internal padding => 12dp visible refresh glyph. -->
    <item
        android:width="12dp"
        android:height="12dp"
        android:gravity="end|bottom"
        android:right="7dp"
        android:bottom="7dp"
        android:drawable="@drawable/ic_refresh" />
</layer-list>
